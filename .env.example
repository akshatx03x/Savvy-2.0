# Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend API Settings
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database
# PostgreSQL (Production canonical DB)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lead_gen_db
# For lightweight local dev fallback without postgres container running:
# DATABASE_URL=sqlite+aiosqlite:///./lead_gen.db

# Redis Task Queue
REDIS_URL=redis://localhost:6379/0

# AI Provider Credentials (Optional - fallback rule parser used if omitted)
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini

# Provider & Synthetic Data Safety
# Strictly set to false in production to prevent synthetic data contamination
ENABLE_SYNTHETIC_DATA=true

# ==========================================
# APPLICATION CONFIGURATION
# ==========================================
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# ==========================================
# SECURITY & CORS
# ==========================================
SECRET_KEY=change_this_to_a_secure_random_string_in_production
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ==========================================
# DATABASE & QUEUE
# ==========================================
DATABASE_URL=sqlite+aiosqlite:///./lead_gen.db
REDIS_URL=redis://localhost:6379/0

# ==========================================
# LEAD SOURCE PROVIDERS
# ==========================================
# Free Public Sources (Zero Cost - Enabled by Default)
OPENSTREETMAP_ENABLED=true

# API Provider Credentials (Optional)
GOOGLE_MAPS_API_KEY=
YELP_API_KEY=
B2B_DIRECTORY_API_KEY=

# ==========================================
# AI PROVIDERS
# ==========================================
# Google Gemini (Primary Recommended AI Provider)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenAI (Fallback AI Provider)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ==========================================
# COST CONTROL & SAFETY
# ==========================================
# Options: free_only (default - zero paid API usage) | free_first
LEAD_COST_MODE=free_only
AI_COST_MODE=free_only

# Synthetic Data Guard (Must be false in production)
ENABLE_SYNTHETIC_DATA=false
